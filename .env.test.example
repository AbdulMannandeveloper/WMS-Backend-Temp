# Test environment. Copy to .env.test and adjust DATABASE_URL for your machine.
#
# Loaded explicitly by test/global-setup.js. The regular .env is NEVER loaded
# during tests — that is deliberate, because .env carries real SMTP credentials
# and a real DATABASE_URL, and a test run must not be able to reach either.

NODE_ENV=test

# --- Database ---
# Must be a DEDICATED test database. Every test truncates every table in it.
#
# Native Postgres (no Docker) — matches the local dev server on 5432 but a
# separate database, so dev data is untouched:
DATABASE_URL="postgres://postgres@localhost:5432/propackers_test"
#
# Docker (docker-compose.test.yml), for CI or machines running Docker:
# DATABASE_URL="postgres://propackers:propackers@localhost:5433/propackers_test"

# --- Auth ---
# Fixed values so signed tokens are reproducible across runs. Test-only —
# these never touch a real environment.
JWT_SECRET="test-jwt-secret-not-used-outside-the-test-suite"
JWT_EXPIRES_IN="12h"
OTP_PEPPER="test-otp-pepper-not-used-outside-the-test-suite"

APP_BASE_URL="http://localhost:5173"
CORS_ORIGINS="http://localhost:5173"

# --- Deliberately unset ---
# REDIS_URL      unset -> lib/redis.js returns null, rate limiter uses memory
# MAIL_TRANSPORT unset -> utils/mailer.js stays in mock mode, sends nothing
# S3_BUCKET      unset -> lib/objectStorage.js uses local disk

# Written files (invoice PDFs, receipts) go somewhere disposable rather than
# into ./uploads, which is a working directory. Removed on teardown.
UPLOAD_DIR=".test-uploads"
