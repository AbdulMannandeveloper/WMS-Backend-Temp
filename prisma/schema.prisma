model Courier {
  id                  String   @id @default(uuid()) @db.Uuid
  code                String   @unique(map: "uq_couriers_code") @db.VarChar(30)
  name                String   @db.VarChar(80)
  // Optional. If set, every manifest tracking number for this courier is checked
  // against it. Left null until real labels prove the pattern, so a wrong regex
  // cannot reject valid boxes.
  trackingRegex       String?  @map("tracking_regex") @db.VarChar(255)
  // Contains the {tracking} placeholder; without it the UI copies the number and
  // opens the search page, as src/lib/couriers.ts does today.
  trackingUrlTemplate String?  @map("tracking_url_template") @db.VarChar(255)
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  depots    CourierDepot[]
  boxes     AirFreightBox[]
  handovers AirFreightHandover[]

  @@index([isActive], map: "idx_couriers_active")
  @@map("couriers")
}

model CourierDepot {
  id        String   @id @default(uuid()) @db.Uuid
  courierId String   @map("courier_id") @db.Uuid
  name      String   @db.VarChar(120)
  address   String?  @db.Text
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  courier   Courier              @relation(fields: [courierId], references: [id], onDelete: Cascade)
  handovers AirFreightHandover[]

  @@unique([courierId, name], map: "uq_courier_depots_courier_name")
  @@index([courierId], map: "idx_courier_depots_courier")
  @@map("courier_depots")
}

model AirFreightClientSettings {
  id                     String                 @id @default(uuid()) @db.Uuid
  clientId               String                 @unique(map: "uq_af_client_settings_client") @map("client_id") @db.Uuid
  chargeableWeightMethod ChargeableWeightMethod @default(PER_BOX) @map("chargeable_weight_method")
  volumetricDivisor      Int                    @default(6000) @map("volumetric_divisor")
  roundingIncrementKg    Decimal                @default(0.50) @map("rounding_increment_kg") @db.Decimal(4, 2)
  freeStorageHours       Int                    @default(48) @map("free_storage_hours")
  emailNotifications     Boolean                @default(false) @map("email_notifications")
  notificationEmail      String?                @map("notification_email") @db.VarChar(255)
  updatedByUserId        String?                @map("updated_by_user_id") @db.Uuid
  updatedAt              DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("air_freight_client_settings")
}

model AirFreightFlight {
  id        String @id @default(uuid()) @db.Uuid
  // AF-<year>-<sequence>, issued the same way as the other module references.
  reference String @unique(map: "uq_air_freight_flights_reference") @db.VarChar(64)
  clientId  String @map("client_id") @db.Uuid

  // The master air waybill. Required at dispatch, normalised to NNN-NNNNNNNN.
  mawbNumber   String? @map("mawb_number") @db.VarChar(20)
  airline      String? @db.VarChar(80)
  flightNumber String? @map("flight_number") @db.VarChar(20)

  // Free text, by decision: no airport dataset. Destination is where the hub is.
  originLocation      String @map("origin_location") @db.VarChar(120)
  destinationLocation String @map("destination_location") @db.VarChar(120)

  etd              DateTime? @db.Timestamptz(6)
  eta              DateTime? @db.Timestamptz(6)
  declaredPieces   Int?      @map("declared_pieces")
  declaredWeightKg Decimal?  @map("declared_weight_kg") @db.Decimal(10, 3)
  notes            String?   @db.Text

  status AirFreightFlightStatus @default(DRAFT)

  // Milestone timestamps. The flight status is recomputed from its boxes; these
  // record when each milestone action happened.
  dispatchedAt    DateTime? @map("dispatched_at") @db.Timestamptz(6)
  landedAt        DateTime? @map("landed_at") @db.Timestamptz(6)
  customsHoldAt   DateTime? @map("customs_hold_at") @db.Timestamptz(6)
  clearedAt       DateTime? @map("cleared_at") @db.Timestamptz(6)
  receiptClosedAt DateTime? @map("receipt_closed_at") @db.Timestamptz(6)
  completedAt     DateTime? @map("completed_at") @db.Timestamptz(6)
  cancelledAt     DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelReason    String?   @map("cancel_reason") @db.Text

  createdByUserId       String? @map("created_by_user_id") @db.Uuid
  dispatchedByUserId    String? @map("dispatched_by_user_id") @db.Uuid
  landedByUserId        String? @map("landed_by_user_id") @db.Uuid
  clearedByUserId       String? @map("cleared_by_user_id") @db.Uuid
  receiptClosedByUserId String? @map("receipt_closed_by_user_id") @db.Uuid
  cancelledByUserId     String? @map("cancelled_by_user_id") @db.Uuid

  // Milestones already emailed, so a resend never doubles up.
  notifiedMilestones String[] @default([]) @map("notified_milestones")

  billingStatus         AirFreightBillingStatus @default(NOT_READY) @map("billing_status")
  billingPostedAt       DateTime?               @map("billing_posted_at") @db.Timestamptz(6)
  billingPostedByUserId String?                 @map("billing_posted_by_user_id") @db.Uuid
  billingPostReason     String?                 @map("billing_post_reason") @db.Text
  // What was actually charged, frozen at post time. Read instead of recomputing
  // once POSTED.
  billingSnapshot       Json?                   @map("billing_snapshot")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  client       Client                @relation(fields: [clientId], references: [id], onDelete: Restrict)
  boxes        AirFreightBox[]
  uploads      AirFreightUpload[]
  exceptions   AirFreightException[]
  boxEvents    AirFreightBoxEvent[]
  invoiceLines InvoiceLineItem[]

  @@index([clientId, createdAt(sort: Desc)], map: "idx_af_flights_client_created_at")
  @@index([status, createdAt(sort: Desc)], map: "idx_af_flights_status_created_at")
  @@index([mawbNumber], map: "idx_af_flights_mawb")
  @@index([createdAt(sort: Desc), id], map: "idx_af_flights_created_at")
  @@map("air_freight_flights")
}

model AirFreightUpload {
  id         String                 @id @default(uuid()) @db.Uuid
  flightId   String                 @map("flight_id") @db.Uuid
  fileName   String                 @map("file_name") @db.VarChar(255)
  storageKey String                 @map("storage_key") @db.VarChar(255)
  fileType   String                 @map("file_type") @db.VarChar(120)
  mode       AirFreightUploadMode
  status     AirFreightUploadStatus @default(PREVIEW)
  rowsTotal  Int                    @map("rows_total")
  rowsOk     Int                    @map("rows_ok")
  rowsError  Int                    @map("rows_error")
  // Arrays of { row, column, message }. Capped by the application at 2,000.
  errors     Json
  warnings   Json
  version    Int?

  uploadedByUserId String?   @map("uploaded_by_user_id") @db.Uuid
  uploadedAt       DateTime  @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  committedAt      DateTime? @map("committed_at") @db.Timestamptz(6)

  flight AirFreightFlight @relation(fields: [flightId], references: [id], onDelete: Cascade)

  @@index([flightId, uploadedAt(sort: Desc)], map: "idx_af_uploads_flight_uploaded_at")
  @@map("air_freight_uploads")
}

model AirFreightBox {
  id        String @id @default(uuid()) @db.Uuid
  flightId  String @map("flight_id") @db.Uuid
  courierId String @map("courier_id") @db.Uuid

  // Normalised (trim, strip spaces, uppercase). Unique across active boxes only,
  // via a partial index in the migration -- Prisma cannot express it, so there
  // is NO @unique here. Never run `prisma migrate dev`: it would drop that index
  // as drift. (Same approach as uq_products_barcode_ci.)
  trackingNumber          String   @map("tracking_number") @db.VarChar(64)
  previousTrackingNumbers String[] @default([]) @map("previous_tracking_numbers")

  clientReference String? @map("client_reference") @db.VarChar(80)
  reference       String? @db.VarChar(80)

  declaredWeightKg Decimal @map("declared_weight_kg") @db.Decimal(10, 3)
  lengthCm         Decimal @map("length_cm") @db.Decimal(8, 1)
  widthCm          Decimal @map("width_cm") @db.Decimal(8, 1)
  heightCm         Decimal @map("height_cm") @db.Decimal(8, 1)

  // Optional correction at receipt. Billing uses these when present.
  measuredWeightKg Decimal?  @map("measured_weight_kg") @db.Decimal(10, 3)
  measuredLengthCm Decimal?  @map("measured_length_cm") @db.Decimal(8, 1)
  measuredWidthCm  Decimal?  @map("measured_width_cm") @db.Decimal(8, 1)
  measuredHeightCm Decimal?  @map("measured_height_cm") @db.Decimal(8, 1)
  measuredByUserId String?   @map("measured_by_user_id") @db.Uuid
  measuredAt       DateTime? @map("measured_at") @db.Timestamptz(6)

  contentsDescription String  @map("contents_description") @db.VarChar(255)
  hsCode              String? @map("hs_code") @db.VarChar(10)
  declaredValue       Decimal @map("declared_value") @db.Decimal(14, 2)
  currency            String  @db.VarChar(3)
  consigneeName       String  @map("consignee_name") @db.VarChar(160)
  consigneePostcode   String  @map("consignee_postcode") @db.VarChar(20)

  status           AirFreightBoxStatus  @default(MANIFESTED)
  // The status to restore when a customs hold is released.
  statusBeforeHold AirFreightBoxStatus? @map("status_before_hold")
  // FLIGHT or BOX -- which hold put it on hold, so a flight-wide clear only lifts
  // flight-wide holds and leaves a box held on its own alone.
  holdScope        String?              @map("hold_scope") @db.VarChar(10)
  currentLocation  String?              @map("current_location") @db.VarChar(120)

  receivedAt       DateTime? @map("received_at") @db.Timestamptz(6)
  receivedByUserId String?   @map("received_by_user_id") @db.Uuid
  handoverId       String?   @map("handover_id") @db.Uuid
  handedOverAt     DateTime? @map("handed_over_at") @db.Timestamptz(6)
  returnedAt       DateTime? @map("returned_at") @db.Timestamptz(6)
  writtenOffAt     DateTime? @map("written_off_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  flight   AirFreightFlight     @relation(fields: [flightId], references: [id], onDelete: Cascade)
  courier  Courier              @relation(fields: [courierId], references: [id], onDelete: Restrict)
  handover AirFreightHandover?  @relation(fields: [handoverId], references: [id], onDelete: SetNull)
  events   AirFreightBoxEvent[]

  @@index([flightId, status], map: "idx_af_boxes_flight_status")
  @@index([courierId, status], map: "idx_af_boxes_courier_status")
  @@index([handoverId], map: "idx_af_boxes_handover")
  @@index([clientReference], map: "idx_af_boxes_client_reference")
  @@index([reference], map: "idx_af_boxes_reference")
  @@map("air_freight_boxes")
}

model AirFreightBoxEvent {
  id         String                @id @default(uuid()) @db.Uuid
  boxId      String                @map("box_id") @db.Uuid
  flightId   String                @map("flight_id") @db.Uuid
  fromStatus AirFreightBoxStatus?  @map("from_status")
  toStatus   AirFreightBoxStatus?  @map("to_status")
  eventType  String                @map("event_type") @db.VarChar(40)
  source     AirFreightEventSource
  userId     String?               @map("user_id") @db.Uuid
  location   String?               @db.VarChar(120)
  note       String?               @db.Text
  photoKey   String?               @map("photo_key") @db.VarChar(255)
  createdAt  DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  box    AirFreightBox    @relation(fields: [boxId], references: [id], onDelete: Cascade)
  flight AirFreightFlight @relation(fields: [flightId], references: [id], onDelete: Cascade)

  @@index([boxId, createdAt], map: "idx_af_box_events_box_created_at")
  @@index([flightId, createdAt], map: "idx_af_box_events_flight_created_at")
  @@map("air_freight_box_events")
}

model AirFreightHandover {
  id         String                   @id @default(uuid()) @db.Uuid
  reference  String                   @unique(map: "uq_af_handovers_reference") @db.VarChar(64)
  courierId  String                   @map("courier_id") @db.Uuid
  depotId    String?                  @map("depot_id") @db.Uuid
  depotName  String                   @map("depot_name") @db.VarChar(120)
  vehicleReg String?                  @map("vehicle_reg") @db.VarChar(20)
  driverName String?                  @map("driver_name") @db.VarChar(120)
  status     AirFreightHandoverStatus @default(OPEN)

  confirmedCount Int?    @map("confirmed_count")
  depotStaffName String? @map("depot_staff_name") @db.VarChar(120)
  closeNote      String? @map("close_note") @db.Text
  proofPhotoKey  String? @map("proof_photo_key") @db.VarChar(255)
  // Written on close: the box list with its outcome. Read by the closed record
  // and the manifest PDF, because a repacked box's live handoverId later moves.
  boxSnapshot    Json?   @map("box_snapshot")

  openedByUserId String?   @map("opened_by_user_id") @db.Uuid
  openedAt       DateTime  @default(now()) @map("opened_at") @db.Timestamptz(6)
  closedByUserId String?   @map("closed_by_user_id") @db.Uuid
  closedAt       DateTime? @map("closed_at") @db.Timestamptz(6)
  cancelledAt    DateTime? @map("cancelled_at") @db.Timestamptz(6)

  courier Courier         @relation(fields: [courierId], references: [id], onDelete: Restrict)
  depot   CourierDepot?   @relation(fields: [depotId], references: [id], onDelete: SetNull)
  boxes   AirFreightBox[]

  @@index([status, openedAt(sort: Desc)], map: "idx_af_handovers_status_opened_at")
  @@index([courierId, openedAt(sort: Desc)], map: "idx_af_handovers_courier_opened_at")
  @@map("air_freight_handovers")
}

model AirFreightException {
  id          String                    @id @default(uuid()) @db.Uuid
  flightId    String                    @map("flight_id") @db.Uuid
  boxId       String?                   @map("box_id") @db.Uuid
  type        AirFreightExceptionType
  status      AirFreightExceptionStatus @default(OPEN)
  // For OVER: the code that was scanned but matched no manifest.
  scannedCode String?                   @map("scanned_code") @db.VarChar(64)
  ownerRole   String                    @map("owner_role") @db.VarChar(20)

  raisedByUserId String?  @map("raised_by_user_id") @db.Uuid
  raisedAt       DateTime @default(now()) @map("raised_at") @db.Timestamptz(6)

  internalNote String? @map("internal_note") @db.Text
  clientNote   String? @map("client_note") @db.Text
  photoKey     String? @map("photo_key") @db.VarChar(255)

  clientDecision     AirFreightClientDecision? @map("client_decision")
  clientDecisionNote String?                   @map("client_decision_note") @db.Text
  clientDecidedAt    DateTime?                 @map("client_decided_at") @db.Timestamptz(6)
  clientLabelKey     String?                   @map("client_label_key") @db.VarChar(255)

  resolution       AirFreightResolution? @map("resolution")
  resolvedByUserId String?               @map("resolved_by_user_id") @db.Uuid
  resolvedAt       DateTime?             @map("resolved_at") @db.Timestamptz(6)

  chargeable Boolean @default(false)

  flight AirFreightFlight @relation(fields: [flightId], references: [id], onDelete: Cascade)

  @@index([status, raisedAt], map: "idx_af_exceptions_status_raised_at")
  @@index([flightId, status], map: "idx_af_exceptions_flight_status")
  @@index([type, status], map: "idx_af_exceptions_type_status")
  @@index([boxId], map: "idx_af_exceptions_box")
  @@map("air_freight_exceptions")
}
