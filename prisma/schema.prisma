generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                         String                     @id @default(uuid()) @db.Uuid
  username                   String?                    @unique @db.VarChar(50)
  firstName                  String                     @map("first_name") @db.VarChar(50)
  lastName                   String                     @map("last_name") @db.VarChar(50)
  email                      String                     @unique @db.VarChar(255)
  passwordHash               String?                    @map("password_hash")
  role                       UserRole
  isActive                   Boolean                    @default(false) @map("is_active")
  // Bumped to invalidate every token already issued to this user. Tokens carry
  // the version they were minted at, so a password reset or a deactivation ends
  // live sessions instead of merely changing a value the holder no longer needs.
  tokenVersion               Int                        @default(0) @map("token_version")
  createdAt                  DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  client                     Client?
  employee                   Employee?
  attendanceLogs             EmployeeAttendanceLog[]
  monthlyAttendanceSummaries MonthlyAttendanceSummary[]
  inventoryLedgerEntries     InventoryLedger[]
  payrollRecords             PayrollRecord[]
  otpVerifications           OtpVerification[]
  invitationTokens           InvitationToken[]
  employeeFines              EmployeeFine[]
  employeeBonuses            EmployeeBonus[]
  auditLogs                  AuditLog[]

  @@map("users")
}

model Client {
  id                 String           @id @default(uuid()) @db.Uuid
  userId             String           @unique @map("user_id") @db.Uuid
  clientUniqueNumber String           @unique @default(dbgenerated()) @map("client_unique_number") @db.VarChar(30)
  companyName        String           @map("company_name") @db.VarChar(200)
  contactName        String           @map("contact_name") @db.VarChar(120)
  email              String           @db.VarChar(255)
  mobile             String?          @db.VarChar(25)
  address            String?
  fixedShipmentRate  Decimal          @default(0.0) @map("fixed_shipment_rate") @db.Decimal(12, 2)
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  shipments          Shipment[]
  clientServices     ClientService[]
  products           Product[]
  monthlyInvoices    MonthlyInvoice[]

  @@map("clients")
}

model Employee {
  id                      String     @id @default(uuid()) @db.Uuid
  userId                  String     @unique @map("user_id") @db.Uuid
  employeeUniqueNumber    String     @unique @default(dbgenerated()) @map("employee_unique_number") @db.VarChar(30)
  jobTitle                String?    @map("job_title") @db.VarChar(120)
  nationalInsuranceNumber String?    @unique @map("national_insurance_number") @db.VarChar(20)
  dateOfBirth             DateTime?  @map("date_of_birth") @db.Date
  wageRate                Decimal?   @map("wage_rate") @db.Decimal(10, 2)
  baseSalary              Decimal?   @map("base_salary") @db.Decimal(12, 2)
  address                 String?
  user                    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  shipments               Shipment[]

  @@map("employees")
}

model Service {
  id               String                   @id @default(uuid()) @db.Uuid
  description      String
  ideaPrice        Decimal                  @map("idea_price") @db.Decimal(12, 2)
  unit             String                   @db.VarChar(30)
  clientServices   ClientService[]
  shipmentMappings ShipmentServiceMapping[]

  @@map("services")
}

model ClientService {
  id           String  @id @default(uuid()) @db.Uuid
  clientId     String  @map("client_id") @db.Uuid
  serviceId    String  @map("service_id") @db.Uuid
  chargedPrice Decimal @map("charged_price") @db.Decimal(12, 2)
  unit         String  @db.VarChar(30)

  client           Client                   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service          Service                  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  invoiceLines     InvoiceLineItem[]
  shipmentMappings ShipmentServiceMapping[]

  @@unique([clientId, serviceId], map: "uq_clients_services_pair")
  @@index([serviceId], map: "idx_clients_services_service_id")
  @@map("clients_services")
}

model Shipment {
  id               String                   @id @default(uuid()) @db.Uuid
  employeeId       String                   @map("employee_id") @db.Uuid
  clientId         String                   @map("client_id") @db.Uuid
  shipmentType     String                   @map("shipment_type") @db.VarChar(30)
  status           ShipmentStatus           @default(PENDING)
  packagingType    String                   @map("packaging_type") @db.VarChar(30)
  courierName      String                   @map("courier_name") @db.VarChar(120)
  // Courier consignment number. Nullable, and no fixed length: couriers differ,
  // and an item may carry its own (see ShipmentItem.trackingId), which wins.
  trackingId       String?                  @map("tracking_id") @db.VarChar(64)
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  // Relations
  employee         Employee                 @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  client           Client                   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  shipmentItems    ShipmentItem[]
  shipmentServices ShipmentServiceMapping[]

  @@index([employeeId, createdAt], map: "idx_shipments_employee_created_at")
  @@index([clientId, createdAt], map: "idx_shipments_client_created_at")
  @@index([trackingId], map: "idx_shipments_tracking_id")
  @@map("shipments")
}

model ExpenseCategory {
  id                String    @id @default(uuid()) @db.Uuid
  categoryName      String    @unique @map("category_name") @db.VarChar(80)
  isSystemGenerated Boolean   @default(false) @map("is_system_generated")
  expenses          Expense[]

  @@map("expense_categories")
}

model Expense {
  id              String          @id @default(uuid()) @db.Uuid
  categoryId      String          @map("category_id") @db.Uuid
  amount          Decimal         @db.Decimal(12, 2)
  description     String?
  date            DateTime        @db.Date
  receiptImageUrl String?         @map("receipt_image_url")
  category        ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([categoryId, date], map: "idx_expenses_category_date")
  @@index([date], map: "idx_expenses_date")
  @@map("expenses")
}

model Shift {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  startTime       DateTime @db.Time // e.g., 08:00:00
  endTime         DateTime @db.Time // e.g., 17:00:00
  gracePeriodMins Int      @default(10)

  @@map("shifts")
}

model Holiday {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  startDate DateTime @db.Date // e.g., 2024-12-25
  endDate   DateTime @db.Date

  @@map("holidays")
}

model EmployeeAttendanceLog {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  // Nullable so admin-marked leave rows do not invent fake clock-ins.
  // Status values used in practice: on-time | late | leave
  loginTimestamp  DateTime? @map("login_timestamp") @db.Timestamptz(6)
  logoutTimestamp DateTime? @map("logout_timestamp") @db.Timestamptz(6)
  status          String    @db.VarChar(20)
  date            DateTime  @db.Date
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date], map: "uq_attendance_user_date")
  @@index([userId, date], map: "idx_attendance_user_date")
  @@map("employee_attendance_logs")
}

model MonthlyAttendanceSummary {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  monthYear         DateTime @map("month_year") @db.Date
  totalDaysPresent  Int      @default(0) @map("total_days_present")
  totalOnTimeDays   Int      @default(0) @map("total_on_time_days")
  totalLateArrivals Int      @default(0) @map("total_late_arrivals")
  totalLeaveDays    Int      @default(0) @map("total_leave_days")
  totalHolidayDays  Int      @default(0) @map("total_holiday_days")
  totalHoursWorked  Decimal  @default(0) @map("total_hours_worked") @db.Decimal(8, 2)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, monthYear], map: "uq_monthly_attendance_user_month")
  @@index([userId, monthYear], map: "idx_monthly_attendance_user_month")
  @@map("monthly_attendance_summary")
}

model WarehouseLocation {
  id               String  @id @default(uuid()) @db.Uuid
  locationName     String  @map("location_name") @db.VarChar(150)
  locationClassId  String  @map("location_class_id") @db.Uuid
  materializedPath String? @map("materialized_path") @db.VarChar(500) // Example value: "zone-a/aisle-2/shelf-3"
  parentLocationId String? @map("parent_location_id") @db.Uuid

  // Hierarchy Relations
  parentLocation WarehouseLocation?     @relation("WarehouseLocationHierarchy", fields: [parentLocationId], references: [id], onDelete: SetNull)
  childLocations WarehouseLocation[]    @relation("WarehouseLocationHierarchy")
  locationClass  WarehouseLocationClass @relation(fields: [locationClassId], references: [id], onDelete: Restrict)

  // Stock State
  stockLevels   StockLevel[]
  shipmentItems ShipmentItem[]

  // Double-Entry Ledger Relations (Updated)
  ledgerOutflows InventoryLedger[] @relation("LedgerFromLocation")
  ledgerInflows  InventoryLedger[] @relation("LedgerToLocation")

  // Guarantees you can't duplicate "Bin 1" inside the exact same Shelf
  @@unique([parentLocationId, locationName], map: "uidx_parent_location_name")
  // Performance & Data Integrity
  @@index([locationClassId], map: "idx_warehouse_location_class_id")
  @@index([parentLocationId], map: "idx_warehouse_parent_location")
  @@index([materializedPath], map: "idx_warehouse_materialized_path")
  @@map("warehouse_locations")
}

model WarehouseLocationClass {
  id            String  @id @default(uuid()) @db.Uuid
  name          String  @unique @map("name") @db.VarChar(80)
  description   String? @db.VarChar(255)
  parentClassId String? @map("parent_class_id") @db.Uuid

  parentClass  WarehouseLocationClass?  @relation("WarehouseLocationClassHierarchy", fields: [parentClassId], references: [id], onDelete: SetNull)
  childClasses WarehouseLocationClass[] @relation("WarehouseLocationClassHierarchy")
  locations    WarehouseLocation[]

  @@index([parentClassId], map: "idx_warehouse_location_classes_parent_class_id")
  @@map("warehouse_location_classes")
}

model Product {
  id             String   @id @default(uuid()) @db.Uuid
  clientId       String   @map("client_id") @db.Uuid
  skuCode        String   @map("sku_code") @db.VarChar(80)
  barcode        String?  @unique(map: "idx_products_barcode_unique") @db.VarChar(64)
  productName    String   @map("product_name") @db.VarChar(200)
  colour         String?  @db.VarChar(50)
  size           String?  @db.VarChar(50)
  weight         Decimal? @db.Decimal(10, 3)
  thresholdLimit Int      @default(0) @map("threshold_limit")
  isDeactivated  Boolean  @default(false) @map("is_deactivated")

  // Relations
  client           Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  stockLevels      StockLevel[]
  inventoryEntries InventoryLedger[]
  shipmentItems    ShipmentItem[]

  @@unique([clientId, skuCode], map: "uq_products_client_sku")
  @@index([clientId], map: "idx_products_client_id")
  @@map("products")
}

model StockLevel {
  id         String @id @default(uuid()) @db.Uuid
  productId  String @map("product_id") @db.Uuid
  locationId String @map("location_id") @db.Uuid

  // The Split State
  currentQuantity  Int @default(0) @map("current_quantity") // Total quantity (reserved or not) currently in the warehouse
  reservedQuantity Int @default(0) @map("reserved_quantity") // Quantity reserved for any shipment order(s)

  arrivedTodayQuantity Int               @default(0) @map("arrived_today_quantity")
  product              Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  location             WarehouseLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([productId, locationId], map: "uq_stock_levels_product_location")
  @@index([productId], map: "idx_stock_levels_product_id")
  @@index([locationId], map: "idx_stock_levels_location_id")
  @@map("stock_levels")
}

// Billable services applied to a shipment (packing, labelling, palletising...).
// Read on dispatch to raise the invoice lines for that shipment.
model ShipmentServiceMapping {
  id               String  @id @default(uuid()) @db.Uuid
  shipmentId       String  @map("shipment_id") @db.Uuid
  serviceId        String  @map("service_id") @db.Uuid
  // Which negotiated rate this came from. Nullable so the mapping survives the
  // client-service row being removed; the price below is already frozen.
  clientServiceId  String? @map("client_service_id") @db.Uuid
  quantity         Decimal @db.Decimal(10, 2)
  // Captured when the service is attached, never recomputed. A later rate change
  // must not rewrite what a client was already charged.
  appliedUnitPrice Decimal @map("applied_unit_price") @db.Decimal(14, 2)

  shipment      Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  service       Service        @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  clientService ClientService? @relation(fields: [clientServiceId], references: [id], onDelete: SetNull)

  // A service is applied to a shipment once; quantity carries the repetition.
  @@unique([shipmentId, serviceId], map: "uq_shipment_service_pair")
  @@index([shipmentId], map: "idx_shipment_services_shipment_id")
  @@map("shipment_service_mappings")
}

// Table to track physical goods allocated to shipment orders
model ShipmentItem {
  id               String             @id @default(uuid()) @db.Uuid
  shipmentId       String             @map("shipment_id") @db.Uuid
  productId        String             @map("product_id") @db.Uuid
  sourceLocationId String             @map("source_location_id") @db.Uuid // Where it's reserved from
  quantity         Int
  status           ShipmentItemStatus @default(PENDING)
  // Set when this line ships under its own consignment number, e.g. an oversized
  // piece travelling separately. Falls back to the shipment's when null.
  trackingId       String?            @map("tracking_id") @db.VarChar(64)

  // Relations
  shipment       Shipment          @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  product        Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  sourceLocation WarehouseLocation @relation(fields: [sourceLocationId], references: [id], onDelete: Restrict)

  @@index([shipmentId], map: "idx_shipment_items_shipment_id")
  @@index([trackingId], map: "idx_shipment_items_tracking_id")
  @@map("shipment_items")
}

model InventoryLedger {
  id           String                @id @default(uuid()) @db.Uuid
  productId    String                @map("product_id") @db.Uuid
  userId       String                @map("user_id") @db.Uuid
  movementType InventoryMovementType @map("movement_type")
  quantity     Int // Always absolute positive value transferred

  // The Double-Entry System
  fromLocationId String? @map("from_location_id") @db.Uuid
  toLocationId   String? @map("to_location_id") @db.Uuid

  // Auditing & Context
  referenceId String?  @map("reference_id") @db.VarChar(100) // Links to Invoice ID, Shipment ID, etc.
  notes       String?  @db.Text
  timestamp   DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  product      Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  user         User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  fromLocation WarehouseLocation? @relation("LedgerFromLocation", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocation   WarehouseLocation? @relation("LedgerToLocation", fields: [toLocationId], references: [id], onDelete: Restrict)

  // Optimized Indices for Warehouse Operations
  @@index([productId, timestamp])
  @@index([fromLocationId, toLocationId])
  @@index([referenceId]) // Critical for finding logs for a specific order
  @@map("inventory_ledger")
}

model ProfitLossLog {
  id            String   @id @default(uuid()) @db.Uuid
  monthYear     DateTime @unique(map: "uq_profit_loss_month") @map("month_year") @db.Date
  totalEarnings Decimal  @default(0) @map("total_earnings") @db.Decimal(14, 2)
  totalExpenses Decimal  @default(0) @map("total_expenses") @db.Decimal(14, 2)
  netProfit     Decimal  @map("net_profit") @db.Decimal(14, 2)

  @@map("profit_loss_logs")
}

model MonthlyInvoice {
  id       String @id @default(uuid()) @db.Uuid
  clientId String @map("client_id") @db.Uuid

  // Always normalize this to the 1st of the month in your code (e.g., 2026-05-01)
  billingPeriod DateTime      @map("billing_period") @db.Date
  totalAmount   Decimal       @default(0.0) @map("total_amount") @db.Decimal(14, 2)
  status        InvoiceStatus @default(DRAFT)
  pdfLink       String?       @map("pdf_link")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  approvedAt    DateTime?     @map("approved_at") @db.Timestamptz(6)

  // Set together when the invoice is marked paid. Method and reference are what
  // a payment query gets answered from, so they are worth capturing at the time
  // rather than reconstructing from a bank statement later.
  paidAt           DateTime? @map("paid_at") @db.Timestamptz(6)
  paymentMethod    String?   @map("payment_method") @db.VarChar(40)
  paymentReference String?   @map("payment_reference") @db.VarChar(120)

  client    Client            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  lineItems InvoiceLineItem[]

  @@unique([clientId, billingPeriod], map: "uidx_client_billing_period")
  @@index([clientId, status], map: "idx_monthly_invoices_client_status")
  @@map("monthly_invoices")
}

model InvoiceLineItem {
  id            String       @id @default(uuid()) @db.Uuid
  invoiceId     String       @map("invoice_id") @db.Uuid
  itemType      LineItemType @map("item_type")
  dateOfService DateTime     @map("date_of_service") @db.Date
  description   String       @db.VarChar(255)
  quantity      Decimal      @db.Decimal(10, 2)
  unitPrice     Decimal      @map("unit_price") @db.Decimal(14, 2)
  totalPrice    Decimal      @map("total_price") @db.Decimal(14, 2)

  // Backlink mapping details
  clientServiceId String? @map("client_service_id") @db.Uuid

  // Relations
  invoice       MonthlyInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  clientService ClientService? @relation(fields: [clientServiceId], references: [id], onDelete: SetNull)

  @@index([invoiceId, dateOfService], map: "idx_line_items_invoice_date")
  @@map("invoice_line_items")
}

model PayrollRecord {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  baseSalary Decimal  @default(0) @map("base_salary") @db.Decimal(14, 2)
  fines      Decimal  @default(0) @db.Decimal(14, 2)
  rewards    Decimal  @default(0) @db.Decimal(14, 2)
  netPay     Decimal  @map("net_pay") @db.Decimal(14, 2)
  monthYear  DateTime @map("month_year") @db.Date
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, monthYear], map: "uq_payroll_user_month")
  @@index([monthYear], map: "idx_payroll_records_month")
  @@map("payroll_records")
}

model OtpVerification {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id") @db.Uuid
  codeHash  String   @map("code_hash") @db.Text
  expiresAt DateTime @map("expires_at") @db.Timestamp(6)
  attempts  Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_otp_verifications_user_id")
  @@map("otp_verifications")
}

model InvitationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Text
  expiresAt DateTime  @map("expires_at") @db.Timestamp(6)
  usedAt    DateTime? @map("used_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_invitation_tokens_user_id")
  @@map("invitation_tokens")
}

enum UserRole {
  admin
  employee
  client
}

// Transitions are enforced in logic/shipment.logic.js — the enum only bounds the
// vocabulary, it does not say which hops are legal.
enum ShipmentStatus {
  PENDING
  READY_FOR_DISPATCH
  DISPATCHED
  CANCELLED
}

enum ShipmentItemStatus {
  PENDING
  PICKED
}

enum InventoryMovementType {
  CHECKIN // Items arriving from a supplier
  INTERNAL_MOVE // Items moving between storage bins
  CHECKOUT // Items leaving the building
}

enum InvoiceStatus {
  DRAFT
  APPROVED
  PAID
}

enum LineItemType {
  AUTOMATED_SERVICE // Logged automatically by operational triggers
  MANUAL_CHARGE // Added manually by an admin
  SHIPMENT_CHARGE // Billing for shipment dispatch
}

model FineRule {
  id          String   @id @default(uuid()) @db.Uuid
  lateMinutes Int      @default(0) @map("late_minutes")
  fineType    String   @map("fine_type") // "FIXED" or "PERCENTAGE"
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("fine_rules")
}

model EmployeeFine {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  reason    String
  amount    Decimal  @db.Decimal(12, 2)
  date      DateTime @db.Date
  cancelled Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("employee_fines")
}

model EmployeeBonus {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  reason    String
  amount    Decimal  @db.Decimal(12, 2)
  date      DateTime @db.Date
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("employee_bonuses")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  action    String // "EDIT_PRODUCT", "DELETE_PRODUCT", "ADJUST_STOCK"
  details   String   @db.Text
  timestamp DateTime @default(now()) @map("timestamp") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}
