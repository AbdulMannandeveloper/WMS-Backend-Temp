generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")

  // Migrations cannot run through a transaction-mode connection pooler:
  // pgbouncer does not support the session-level advisory locks Prisma takes to
  // stop two deploys migrating at once. Supabase's pooler (port 6543) is exactly
  // that, so `prisma migrate deploy` needs a direct connection (port 5432).
  //
  // Prisma requires this to be set, it does not fall back to DATABASE_URL. Where
  // there is no pooler — local development, CI — point it at the same database
  // as DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  username     String?  @unique @db.VarChar(50)
  firstName    String   @map("first_name") @db.VarChar(50)
  lastName     String   @map("last_name") @db.VarChar(50)
  email        String   @unique @db.VarChar(255)
  passwordHash String?  @map("password_hash")
  role         UserRole
  isActive     Boolean  @default(false) @map("is_active")
  // Bumped to invalidate every token already issued to this user. Tokens carry
  // the version they were minted at, so a password reset or a deactivation ends
  // live sessions instead of merely changing a value the holder no longer needs.
  tokenVersion Int      @default(0) @map("token_version")

  /// What an employee may do, as `module:action` strings — see utils/permissions.js.
  ///
  /// A column on User rather than a table on Employee, because the auth
  /// middleware already loads this whole row and caches it: a list of at most
  /// sixteen short strings rides along for free, where a relation would need an
  /// include on a repository several other callers share.
  ///
  /// Empty for everyone until an admin grants. Ignored for admin and client —
  /// an admin is never governed by it, and a client is narrowed by clientScope.
  permissions                String[]                   @default([])
  createdAt                  DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  client                     Client?
  employee                   Employee?
  attendanceLogs             EmployeeAttendanceLog[]
  monthlyAttendanceSummaries MonthlyAttendanceSummary[]
  inventoryLedgerEntries     InventoryLedger[]
  payrollRecords             PayrollRecord[]
  otpVerifications           OtpVerification[]
  invitationTokens           InvitationToken[]
  employeeFines              EmployeeFine[]
  employeeBonuses            EmployeeBonus[]
  auditLogs                  AuditLog[]
  shipmentsCreated           Shipment[]                 @relation("ShipmentCreatedBy")

  @@index([role, firstName, lastName, id], map: "idx_users_role_name")
  @@index([isActive], map: "idx_users_is_active")
  @@map("users")
}

model Client {
  id                 String                    @id @default(uuid()) @db.Uuid
  userId             String                    @unique @map("user_id") @db.Uuid
  clientUniqueNumber String                    @unique @default(dbgenerated()) @map("client_unique_number") @db.VarChar(30)
  companyName        String                    @map("company_name") @db.VarChar(200)
  contactName        String                    @map("contact_name") @db.VarChar(120)
  email              String                    @db.VarChar(255)
  mobile             String?                   @db.VarChar(25)
  address            String?
  user               User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  shipments          Shipment[]
  clientServices     ClientService[]
  fbaShipments       FbaShipment[]
  products           Product[]
  monthlyInvoices    MonthlyInvoice[]
  productReturns     ProductReturn[]
  airFreightFlights  AirFreightFlight[]
  airFreightSettings AirFreightClientSettings?

  @@map("clients")
}

model Employee {
  id                      String     @id @default(uuid()) @db.Uuid
  userId                  String     @unique @map("user_id") @db.Uuid
  employeeUniqueNumber    String     @unique @default(dbgenerated()) @map("employee_unique_number") @db.VarChar(30)
  jobTitle                String?    @map("job_title") @db.VarChar(120)
  nationalInsuranceNumber String?    @unique @map("national_insurance_number") @db.VarChar(20)
  dateOfBirth             DateTime?  @map("date_of_birth") @db.Date
  wageRate                Decimal?   @map("wage_rate") @db.Decimal(10, 2)
  baseSalary              Decimal?   @map("base_salary") @db.Decimal(12, 2)
  address                 String?
  user                    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  shipments               Shipment[]

  @@map("employees")
}

model Service {
  id               String                   @id @default(uuid()) @db.Uuid
  description      String
  ideaPrice        Decimal                  @map("idea_price") @db.Decimal(12, 2)
  unit             String                   @db.VarChar(30)
  // Stable identifier for services the system itself raises, so the code can
  // find one without matching on a description an admin may rename.
  // Today: SHIPMENT_DISPATCH. Null for ordinary catalogue entries.
  code             String?                  @unique @db.VarChar(40)
  // Off: kept on the shipments, rates and invoices that carry it, but offered
  // for nothing new. Built-in services (with a code) are never switched off.
  isActive         Boolean                  @default(true) @map("is_active")
  clientServices   ClientService[]
  shipmentMappings ShipmentServiceMapping[]
  fbaServices      FbaShipmentService[]

  @@map("services")
}

model ClientService {
  id               String                   @id @default(uuid()) @db.Uuid
  clientId         String                   @map("client_id") @db.Uuid
  serviceId        String                   @map("service_id") @db.Uuid
  chargedPrice     Decimal                  @map("charged_price") @db.Decimal(12, 2)
  unit             String                   @db.VarChar(30)
  client           Client                   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service          Service                  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  invoiceLines     InvoiceLineItem[]
  shipmentMappings ShipmentServiceMapping[]
  fbaServices      FbaShipmentService[]

  @@unique([clientId, serviceId], map: "uq_clients_services_pair")
  @@index([serviceId], map: "idx_clients_services_service_id")
  @@map("clients_services")
}

model Shipment {
  id               String                   @id @default(uuid()) @db.Uuid
  // The label scanned off the parcel at the bench. Unique, because two
  // shipments sharing an identity cannot be told apart afterwards by anyone —
  // not the warehouse, not the courier, not the client querying an invoice.
  reference        String                   @unique(map: "uq_shipments_reference") @db.VarChar(64)
  // Who made it. A User rather than an Employee: an admin dispatching a parcel
  // is doing the work whether or not they are on the payroll, and requiring an
  // Employee row meant admins could not dispatch at all.
  createdByUserId  String?                  @map("created_by_user_id") @db.Uuid
  // Optional now. The rows written before createdByUserId existed carry their
  // employee, and payroll and attendance still key on it.
  employeeId       String?                  @map("employee_id") @db.Uuid
  clientId         String                   @map("client_id") @db.Uuid
  status           ShipmentStatus           @default(PENDING)
  // Courier consignment number. Nullable, and no fixed length: couriers differ,
  // and an item may carry its own (see ShipmentItem.trackingId), which wins.
  trackingId       String?                  @map("tracking_id") @db.VarChar(64)
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  // Relations
  createdBy        User?                    @relation("ShipmentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  employee         Employee?                @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  client           Client                   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  shipmentItems    ShipmentItem[]
  shipmentServices ShipmentServiceMapping[]
  invoiceLines     InvoiceLineItem[]
  productReturns   ProductReturn[]

  @@index([employeeId, createdAt], map: "idx_shipments_employee_created_at")
  @@index([clientId, createdAt], map: "idx_shipments_client_created_at")
  @@index([trackingId], map: "idx_shipments_tracking_id")
  @@index([createdAt(sort: Desc), id], map: "idx_shipments_created_at")
  @@index([status, createdAt(sort: Desc)], map: "idx_shipments_status_created_at")
  @@index([createdByUserId, createdAt(sort: Desc)], map: "idx_shipments_created_by_created_at")
  @@map("shipments")
}

model ExpenseCategory {
  id                String    @id @default(uuid()) @db.Uuid
  // Also unique ignoring case: uq_expense_categories_name_ci on
  // lower(category_name), migration 20261003150000 (expression index; SQL only).
  categoryName      String    @unique @map("category_name") @db.VarChar(80)
  isSystemGenerated Boolean   @default(false) @map("is_system_generated")
  expenses          Expense[]

  @@map("expense_categories")
}

model Expense {
  id              String          @id @default(uuid()) @db.Uuid
  categoryId      String          @map("category_id") @db.Uuid
  amount          Decimal         @db.Decimal(12, 2)
  description     String?
  date            DateTime        @db.Date
  receiptImageUrl String?         @map("receipt_image_url")
  category        ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([categoryId, date], map: "idx_expenses_category_date")
  @@index([date], map: "idx_expenses_date")
  @@index([amount], map: "idx_expenses_amount")
  @@map("expenses")
}

model Shift {
  id              String   @id @default(uuid()) @db.Uuid
  // Unique ignoring case: uq_shifts_name_ci on lower(name), migration
  // 20261003150000 (expression index; SQL only). Check-in finds "default" by it.
  name            String
  startTime       DateTime @db.Time // e.g., 08:00:00
  endTime         DateTime @db.Time // e.g., 17:00:00
  gracePeriodMins Int      @default(10)

  @@map("shifts")
}

model Holiday {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  startDate DateTime @db.Date // e.g., 2024-12-25
  endDate   DateTime @db.Date

  @@map("holidays")
}

model EmployeeAttendanceLog {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  // Nullable so admin-marked leave rows do not invent fake clock-ins.
  // Status values used in practice: on-time | late | leave
  loginTimestamp  DateTime? @map("login_timestamp") @db.Timestamptz(6)
  logoutTimestamp DateTime? @map("logout_timestamp") @db.Timestamptz(6)
  status          String    @db.VarChar(20)
  date            DateTime  @db.Date
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date], map: "uq_attendance_user_date")
  @@index([userId, date], map: "idx_attendance_user_date")
  @@index([date(sort: Desc), id], map: "idx_attendance_date")
  @@index([date, status], map: "idx_attendance_date_status")
  @@map("employee_attendance_logs")
}

model MonthlyAttendanceSummary {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  monthYear         DateTime @map("month_year") @db.Date
  totalDaysPresent  Int      @default(0) @map("total_days_present")
  totalOnTimeDays   Int      @default(0) @map("total_on_time_days")
  totalLateArrivals Int      @default(0) @map("total_late_arrivals")
  totalLeaveDays    Int      @default(0) @map("total_leave_days")
  totalHolidayDays  Int      @default(0) @map("total_holiday_days")
  totalHoursWorked  Decimal  @default(0) @map("total_hours_worked") @db.Decimal(8, 2)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, monthYear], map: "uq_monthly_attendance_user_month")
  @@index([userId, monthYear], map: "idx_monthly_attendance_user_month")
  @@map("monthly_attendance_summary")
}

model WarehouseLocation {
  id               String  @id @default(uuid()) @db.Uuid
  locationName     String  @map("location_name") @db.VarChar(150)
  locationClassId  String  @map("location_class_id") @db.Uuid
  materializedPath String? @map("materialized_path") @db.VarChar(500) // Example value: "zone-a/aisle-2/shelf-3"
  parentLocationId String? @map("parent_location_id") @db.Uuid
  // Off: kept, with its stock history, but no stock can be put into it and
  // nothing new can go inside it. Only an empty location can be switched off.
  isActive         Boolean @default(true) @map("is_active")

  // Hierarchy Relations
  parentLocation WarehouseLocation?     @relation("WarehouseLocationHierarchy", fields: [parentLocationId], references: [id], onDelete: SetNull)
  childLocations WarehouseLocation[]    @relation("WarehouseLocationHierarchy")
  locationClass  WarehouseLocationClass @relation(fields: [locationClassId], references: [id], onDelete: Restrict)

  // Stock State
  stockLevels      StockLevel[]
  shipmentItems    ShipmentItem[]
  fbaItems         FbaShipmentItem[]
  restockedReturns ProductReturn[]

  // Double-Entry Ledger Relations (Updated)
  ledgerOutflows InventoryLedger[] @relation("LedgerFromLocation")
  ledgerInflows  InventoryLedger[] @relation("LedgerToLocation")

  // Guarantees you can't duplicate "Bin 1" inside the exact same Shelf.
  // Also unique ignoring case, through an expression index Prisma cannot
  // declare: uq_warehouse_locations_parent_name_ci on (parent_location_id,
  // lower(location_name)), migration 20261003140000. migrate diff ignores it.
  @@unique([parentLocationId, locationName], map: "uidx_parent_location_name")
  // Performance & Data Integrity
  @@index([locationClassId], map: "idx_warehouse_location_class_id")
  @@index([parentLocationId], map: "idx_warehouse_parent_location")
  @@index([materializedPath], map: "idx_warehouse_materialized_path")
  @@index([locationName, id], map: "idx_warehouse_locations_name")
  @@map("warehouse_locations")
}

model WarehouseLocationClass {
  id            String  @id @default(uuid()) @db.Uuid
  // Also unique ignoring case: uq_warehouse_location_classes_name_ci on
  // lower(name), migration 20261003140000 (an expression index; SQL only).
  name          String  @unique @map("name") @db.VarChar(80)
  description   String? @db.VarChar(255)
  parentClassId String? @map("parent_class_id") @db.Uuid
  // Off: kept for the locations that have it, but no new location takes it.
  isActive      Boolean @default(true) @map("is_active")

  parentClass  WarehouseLocationClass?  @relation("WarehouseLocationClassHierarchy", fields: [parentClassId], references: [id], onDelete: SetNull)
  childClasses WarehouseLocationClass[] @relation("WarehouseLocationClassHierarchy")
  locations    WarehouseLocation[]

  @@index([parentClassId], map: "idx_warehouse_location_classes_parent_class_id")
  @@map("warehouse_location_classes")
}

model Product {
  id             String   @id @default(uuid()) @db.Uuid
  clientId       String   @map("client_id") @db.Uuid
  skuCode        String   @map("sku_code") @db.VarChar(80)
  barcode        String?  @unique(map: "idx_products_barcode_unique") @db.VarChar(64)
  productName    String   @map("product_name") @db.VarChar(200)
  colour         String?  @db.VarChar(50)
  size           String?  @db.VarChar(50)
  weight         Decimal? @db.Decimal(10, 3)
  thresholdLimit Int      @default(0) @map("threshold_limit")
  isDeactivated  Boolean  @default(false) @map("is_deactivated")

  // Relations
  client           Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  stockLevels      StockLevel[]
  inventoryEntries InventoryLedger[]
  shipmentItems    ShipmentItem[]
  fbaItems         FbaShipmentItem[]
  productReturns   ProductReturn[]

  // Also unique ignoring case, through expression indexes Prisma cannot
  // declare: uq_products_client_sku_ci on (client_id, lower(sku_code)) and
  // uq_products_barcode_ci on lower(barcode), both in migration
  // 20261003130000_case_insensitive_product_codes. migrate diff ignores them,
  // so they survive later migrations; they are only visible in SQL.
  @@unique([clientId, skuCode], map: "uq_products_client_sku")
  @@index([clientId], map: "idx_products_client_id")
  @@index([productName, id], map: "idx_products_product_name")
  @@index([clientId, productName], map: "idx_products_client_product_name")
  @@index([skuCode], map: "idx_products_sku_code")
  @@map("products")
}

model StockLevel {
  id         String @id @default(uuid()) @db.Uuid
  productId  String @map("product_id") @db.Uuid
  locationId String @map("location_id") @db.Uuid

  // The Split State
  currentQuantity  Int @default(0) @map("current_quantity") // Total quantity (reserved or not) currently in the warehouse
  reservedQuantity Int @default(0) @map("reserved_quantity") // Quantity reserved for any shipment order(s)

  arrivedTodayQuantity Int               @default(0) @map("arrived_today_quantity")
  product              Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  location             WarehouseLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([productId, locationId], map: "uq_stock_levels_product_location")
  @@index([productId], map: "idx_stock_levels_product_id")
  @@index([locationId], map: "idx_stock_levels_location_id")
  @@map("stock_levels")
}

// Billable services applied to a shipment (packing, labelling, palletising...).
// Read on dispatch to raise the invoice lines for that shipment.
model ShipmentServiceMapping {
  id               String  @id @default(uuid()) @db.Uuid
  shipmentId       String  @map("shipment_id") @db.Uuid
  serviceId        String  @map("service_id") @db.Uuid
  // Which negotiated rate this came from. Nullable so the mapping survives the
  // client-service row being removed; the price below is already frozen.
  clientServiceId  String? @map("client_service_id") @db.Uuid
  quantity         Decimal @db.Decimal(10, 2)
  // Captured when the service is attached, never recomputed. A later rate change
  // must not rewrite what a client was already charged.
  appliedUnitPrice Decimal @map("applied_unit_price") @db.Decimal(14, 2)

  shipment      Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  service       Service        @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  clientService ClientService? @relation(fields: [clientServiceId], references: [id], onDelete: SetNull)

  // A service is applied to a shipment once; quantity carries the repetition.
  @@unique([shipmentId, serviceId], map: "uq_shipment_service_pair")
  @@index([shipmentId], map: "idx_shipment_services_shipment_id")
  @@map("shipment_service_mappings")
}

// Table to track physical goods allocated to shipment orders
model ShipmentItem {
  id               String             @id @default(uuid()) @db.Uuid
  shipmentId       String             @map("shipment_id") @db.Uuid
  productId        String             @map("product_id") @db.Uuid
  sourceLocationId String             @map("source_location_id") @db.Uuid // Where it's reserved from
  quantity         Int
  // How much of this line has come back after dispatch. Kept per line rather
  // than as a separate table because a return is a correction to what went out,
  // and capping at (quantity - returnedQuantity) is what stops the same ten
  // units being returned twice.
  returnedQuantity Int                @default(0) @map("returned_quantity")
  status           ShipmentItemStatus @default(PENDING)
  // Set when this line ships under its own consignment number, e.g. an oversized
  // piece travelling separately. Falls back to the shipment's when null.
  trackingId       String?            @map("tracking_id") @db.VarChar(64)

  // Relations
  shipment       Shipment          @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  product        Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  sourceLocation WarehouseLocation @relation(fields: [sourceLocationId], references: [id], onDelete: Restrict)
  productReturns ProductReturn[]

  @@index([shipmentId], map: "idx_shipment_items_shipment_id")
  @@index([trackingId], map: "idx_shipment_items_tracking_id")
  @@map("shipment_items")
}

model InventoryLedger {
  id           String                @id @default(uuid()) @db.Uuid
  productId    String                @map("product_id") @db.Uuid
  userId       String                @map("user_id") @db.Uuid
  movementType InventoryMovementType @map("movement_type")
  quantity     Int // Always absolute positive value transferred

  // The Double-Entry System
  fromLocationId String? @map("from_location_id") @db.Uuid
  toLocationId   String? @map("to_location_id") @db.Uuid

  // Auditing & Context
  referenceId String?  @map("reference_id") @db.VarChar(100) // Links to Invoice ID, Shipment ID, etc.
  notes       String?  @db.Text
  timestamp   DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  product      Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  user         User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  fromLocation WarehouseLocation? @relation("LedgerFromLocation", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocation   WarehouseLocation? @relation("LedgerToLocation", fields: [toLocationId], references: [id], onDelete: Restrict)

  // Optimized Indices for Warehouse Operations
  @@index([productId, timestamp])
  @@index([fromLocationId, toLocationId])
  @@index([referenceId]) // Critical for finding logs for a specific order
  @@index([timestamp(sort: Desc), id], map: "idx_inventory_ledger_timestamp")
  @@index([movementType, timestamp(sort: Desc)], map: "idx_inventory_ledger_movement_timestamp")
  @@index([userId, timestamp(sort: Desc)], map: "idx_inventory_ledger_user_timestamp")
  @@map("inventory_ledger")
}

model ProfitLossLog {
  id            String   @id @default(uuid()) @db.Uuid
  monthYear     DateTime @unique(map: "uq_profit_loss_month") @map("month_year") @db.Date
  totalEarnings Decimal  @default(0) @map("total_earnings") @db.Decimal(14, 2)
  totalExpenses Decimal  @default(0) @map("total_expenses") @db.Decimal(14, 2)
  netProfit     Decimal  @map("net_profit") @db.Decimal(14, 2)

  @@map("profit_loss_logs")
}

/**
 * Platform-wide settings, as key/value.
 * A table rather than an environment variable so the value can be changed
 * without a redeploy and carries who changed it and when — a tax rate is the
 * kind of number somebody will eventually need to account for.
 */
model Setting {
  key         String   @id @db.VarChar(60)
  value       String   @db.VarChar(255)
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("settings")
}

model MonthlyInvoice {
  id       String @id @default(uuid()) @db.Uuid
  clientId String @map("client_id") @db.Uuid

  // Always normalize this to the 1st of the month in your code (e.g., 2026-05-01)
  billingPeriod DateTime      @map("billing_period") @db.Date
  // The sum of the line items, EXCLUDING tax. Deliberately ex-tax: profit_loss
  // reads this as company earnings, and VAT is collected for HMRC rather than
  // earned, so folding it in here would overstate profit by the tax rate.
  totalAmount   Decimal       @default(0.0) @map("total_amount") @db.Decimal(14, 2)
  status        InvoiceStatus @default(DRAFT)

  // Tax, opted into per invoice while it is still DRAFT.
  //
  // taxRate is snapshotted when tax is applied rather than read live at render
  // time: an invoice already sent to a client must not silently change because
  // the platform rate moved afterwards.
  taxApplied Boolean   @default(false) @map("tax_applied")
  taxRate    Decimal?  @map("tax_rate") @db.Decimal(5, 2)
  taxAmount  Decimal   @default(0.0) @map("tax_amount") @db.Decimal(14, 2)
  pdfLink    String?   @map("pdf_link")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  approvedAt DateTime? @map("approved_at") @db.Timestamptz(6)

  // Set together when the invoice is marked paid. Method and reference are what
  // a payment query gets answered from, so they are worth capturing at the time
  // rather than reconstructing from a bank statement later.
  paidAt           DateTime? @map("paid_at") @db.Timestamptz(6)
  paymentMethod    String?   @map("payment_method") @db.VarChar(40)
  paymentReference String?   @map("payment_reference") @db.VarChar(120)

  client    Client            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  lineItems InvoiceLineItem[]

  /// Total due — total_amount + tax_amount, computed by Postgres.
  ///
  /// The invoices list filters and sorts on this, and Prisma cannot filter or
  /// order by an expression; applying it after the page was read would make the
  /// reported total wrong. So the database computes it.
  ///
  /// GENERATED ALWAYS rather than a column the application maintains, because
  /// three places move these figures — recalculateInvoiceTotal, setInvoiceTax
  /// (which writes taxAmount directly) and applyInvoiceEdits — and a derived
  /// total with three writers drifts eventually.
  ///
  /// Prisma 6 cannot express GENERATED ALWAYS, so this is modelled the closest
  /// way it can be: NOT NULL with a database-supplied default. The clause
  /// itself lives in 20260920010000_list_filter_indexes.
  ///
  /// The NOT NULL is load-bearing. Declared nullable, Prisma emits an explicit
  /// NULL for this field on every insert, Postgres refuses it because the
  /// column is generated, and every invoice creation fails — which is dispatch,
  /// returns and billing all at once. Non-null, Prisma leaves it out of the
  /// INSERT entirely. Do not make it optional to "match" the database.
  ///
  /// NEVER WRITE TO THIS. Postgres rejects a write to a generated column, and
  /// computing it here would reintroduce the drift it exists to prevent.
  grandTotal Decimal @default(dbgenerated("(total_amount + tax_amount)")) @map("grand_total") @db.Decimal(14, 2)

  @@unique([clientId, billingPeriod], map: "uidx_client_billing_period")
  @@index([clientId, status], map: "idx_monthly_invoices_client_status")
  @@index([billingPeriod(sort: Desc), id], map: "idx_monthly_invoices_billing_period")
  @@index([status, billingPeriod(sort: Desc)], map: "idx_monthly_invoices_status_billing_period")
  @@index([createdAt(sort: Desc)], map: "idx_monthly_invoices_created_at")
  @@index([grandTotal], map: "idx_monthly_invoices_grand_total")
  @@map("monthly_invoices")
}

model InvoiceLineItem {
  id            String       @id @default(uuid()) @db.Uuid
  invoiceId     String       @map("invoice_id") @db.Uuid
  itemType      LineItemType @map("item_type")
  dateOfService DateTime     @map("date_of_service") @db.Date
  description   String       @db.VarChar(255)
  quantity      Decimal      @db.Decimal(10, 2)
  unitPrice     Decimal      @map("unit_price") @db.Decimal(14, 2)
  totalPrice    Decimal      @map("total_price") @db.Decimal(14, 2)

  // Backlink mapping details
  clientServiceId String? @map("client_service_id") @db.Uuid

  // The dispatched shipment this charge is for, when the line is a
  // SHIPMENT_CHARGE. Nullable — most line types have no shipment — and set on
  // dispatch so deleting a shipment can find and reverse exactly its own
  // charge, rather than matching on the description string. onDelete SetNull is
  // only a backstop: deleteShipment removes the line before the row goes, so
  // this normally never fires.
  // Also set on the MANUAL_CHARGE the line return button raises, so undoing a
  // shipment's line returns can find it. Readers of shipment charges filter on
  // itemType SHIPMENT_CHARGE.
  shipmentId String? @map("shipment_id") @db.Uuid

  // The same for a bulk shipment: its Bulk Shipment charge and the services
  // charged with it at dispatch.
  fbaShipmentId String? @map("fba_shipment_id") @db.Uuid

  // The return this charge is for — the handling charge raised when it was
  // recorded, or the restock charge raised when it went back on the shelf. The
  // same reasoning as shipmentId: the returns screen shows what a return cost
  // by following this, not by matching RET-… in the description.
  returnId String? @map("return_id") @db.Uuid

  // The air freight flight this charge belongs to. Set when the flight's billing
  // is posted, so unposting can find and reverse exactly these lines by id
  // rather than matching AF-… in the description.
  airFreightFlightId String? @map("air_freight_flight_id") @db.Uuid

  // Relations
  invoice          MonthlyInvoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  clientService    ClientService?    @relation(fields: [clientServiceId], references: [id], onDelete: SetNull)
  shipment         Shipment?         @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  fbaShipment      FbaShipment?      @relation(fields: [fbaShipmentId], references: [id], onDelete: SetNull)
  productReturn    ProductReturn?    @relation(fields: [returnId], references: [id], onDelete: SetNull)
  airFreightFlight AirFreightFlight? @relation(fields: [airFreightFlightId], references: [id], onDelete: SetNull)

  @@index([invoiceId, dateOfService], map: "idx_line_items_invoice_date")
  @@index([shipmentId], map: "idx_line_items_shipment_id")
  @@index([fbaShipmentId], map: "idx_line_items_fba_shipment_id")
  @@index([returnId], map: "idx_line_items_return_id")
  @@index([airFreightFlightId], map: "idx_line_items_air_freight_flight_id")
  @@map("invoice_line_items")
}

