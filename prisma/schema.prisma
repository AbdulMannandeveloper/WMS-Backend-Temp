}

// Transitions are enforced in logic/shipment.logic.js — the enum only bounds the
// vocabulary, it does not say which hops are legal.
enum ShipmentStatus {
  PENDING
  READY_FOR_DISPATCH
  DISPATCHED
  CANCELLED
}

enum ShipmentItemStatus {
  PENDING
  PICKED
}

enum InventoryMovementType {
  CHECKIN // Items arriving from a supplier
  INTERNAL_MOVE // Items moving between storage bins
  CHECKOUT // Items leaving the building
  RETURN // Items coming back after dispatch — distinct from CHECKIN, which is a supplier delivery
  // Stock written off the shelf with no shipment behind it: damage, loss, a
  // miscount. Distinct from CHECKOUT, which must name the shipment it left on —
  // without this the only way to correct a count was to invent a dispatch.
  ADJUSTMENT
}

enum InvoiceStatus {
  DRAFT
  APPROVED
  PAID
}

/**
 * FBA consignments are recorded by hand, not scanned, and never stored against a
 * warehouse location — the goods pass through rather than being put away. So
 * they carry no product, no stock level and no ledger movement: just what
 * arrived, for whom, and when it left.
 */
enum FbaShipmentStatus {
  // The three-step bulk flow: created empty, then products scanned in, then
  // dispatched. RECEIVED is the legacy single-step status, kept for old rows.
  DRAFT
  PREPARING
  RECEIVED
  DISPATCHED
  CANCELLED
}

model FbaCategory {
  id        String        @id @default(uuid()) @db.Uuid
  // Also unique ignoring case: uq_fba_categories_name_ci on lower(name),
  // migration 20261003150000 (expression index; SQL only).
  name      String        @unique @db.VarChar(120)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  shipments FbaShipment[]

  @@map("fba_categories")
}

model FbaShipment {
  id                  String            @id @default(uuid()) @db.Uuid
  // The bulk-shipment number the system issues, e.g. BULK-2026-000123. Unique
  // and generated the same way as the outbound Shipment.reference.
  reference           String            @unique(map: "uq_fba_shipments_reference") @db.VarChar(64)
  categoryId          String            @map("category_id") @db.Uuid
  clientId            String            @map("client_id") @db.Uuid
  // Legacy single-consignment fields from the old record-arrival flow. Nullable
  // now — the multi-product flow carries goods as FbaShipmentItem rows instead.
  barcode             String?           @db.VarChar(64)
  size                String?           @db.VarChar(60)
  count               Int?
  // Where the bulk shipment is going (e.g. "Amazon Global"), the delivery note,
  // and the courier's tracking number.
  destination         String?           @db.VarChar(160)
  // Instructions printed on the delivery note. Legacy rows used this for the
  // floor too, which is why the pick screen still shows it.
  deliveryNote        String?           @map("delivery_note") @db.Text
  trackingId          String?           @map("tracking_id") @db.VarChar(64)
  // Mode of dispatch — carrier and service, e.g. "EVRI NEXT DAY". Printed as the
  // carrier on the delivery note.
  dispatchMode        String?           @map("dispatch_mode") @db.VarChar(80)
  // For the people picking it. Never printed.
  staffNote           String?           @map("staff_note") @db.Text
  // The rest of the delivery note: the client's order reference, the full
  // deliver-to block (destination above is its name), and the collection.
  orderReference      String?           @map("order_reference") @db.VarChar(64)
  deliveryAddress     String?           @map("delivery_address") @db.Text
  deliveryPostcode    String?           @map("delivery_postcode") @db.VarChar(20)
  deliveryContact     String?           @map("delivery_contact") @db.VarChar(120)
  vehicleRegistration String?           @map("vehicle_registration") @db.VarChar(20)
  palletCount         Int?              @map("pallet_count")
  status              FbaShipmentStatus @default(DRAFT)
  // Who carried out each of the three steps. Plain ids rather than relations:
  // this is an audit breadcrumb, and the three steps may all be one person.
  createdByUserId     String?           @map("created_by_user_id") @db.Uuid
  preparedByUserId    String?           @map("prepared_by_user_id") @db.Uuid
  dispatchedByUserId  String?           @map("dispatched_by_user_id") @db.Uuid
  receivedAt          DateTime          @default(now()) @map("received_at") @db.Timestamptz(6)
  dispatchedAt        DateTime?         @map("dispatched_at") @db.Timestamptz(6)
  notes               String?           @db.Text

  category       FbaCategory          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  client         Client               @relation(fields: [clientId], references: [id], onDelete: Restrict)
  items          FbaShipmentItem[]
  services       FbaShipmentService[]
  // The charges its dispatch raised, so deleting it can take exactly those off
  // the invoice.
  invoiceLines   InvoiceLineItem[]
  productReturns ProductReturn[]

  @@index([clientId, status], map: "idx_fba_shipments_client_status")
  @@index([barcode], map: "idx_fba_shipments_barcode")
  @@index([receivedAt(sort: Desc), id], map: "idx_fba_shipments_received_at")
  @@index([status, receivedAt(sort: Desc)], map: "idx_fba_shipments_status_received_at")
  @@index([categoryId, receivedAt(sort: Desc)], map: "idx_fba_shipments_category_received_at")
  @@map("fba_shipments")
}

/**
 * A product scanned into a bulk shipment during the prepare step, with the
 * quantity going out and the bin it comes from. Reserved on prepare and checked
 * out on dispatch, the same two-phase move an outbound ShipmentItem makes.
 */
model FbaShipmentItem {
  id               String   @id @default(uuid()) @db.Uuid
  fbaShipmentId    String   @map("fba_shipment_id") @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  // What the office planned to send. Reserved from the source bin at creation.
  quantity         Int
  // How many the floor has scanned against this line. Dispatch is refused
  // until it equals quantity on every line, so nothing leaves unchecked.
  pickedQuantity   Int      @default(0) @map("picked_quantity")
  // Running total of picked units put back on the shelf, recorded when a pick
  // count is lowered. Picked goods block voiding, deleting, changing client and
  // cutting the plan below them until they are put back.
  putBackQuantity  Int      @default(0) @map("put_back_quantity")
  // How much of this line has come back after dispatch. Capped at quantity, so
  // the same units cannot be returned twice. The dispatch charge is never
  // changed by a return; a return fee, when one applies, is its own line.
  returnedQuantity Int      @default(0) @map("returned_quantity")
  // Cartons this line travels in, for the delivery note. Optional: units per
  // box is derived from it rather than stored.
  boxes            Int?
  sourceLocationId String   @map("source_location_id") @db.Uuid
  // The code scanned to add it, kept for the packing record.
  barcode          String?  @db.VarChar(64)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  fbaShipment    FbaShipment       @relation(fields: [fbaShipmentId], references: [id], onDelete: Cascade)
  product        Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  sourceLocation WarehouseLocation @relation(fields: [sourceLocationId], references: [id], onDelete: Restrict)
  productReturns ProductReturn[]

  @@index([fbaShipmentId], map: "idx_fba_shipment_items_shipment")
  @@index([productId], map: "idx_fba_shipment_items_product")
  @@map("fba_shipment_items")
}

/**
 * Goods coming back to the warehouse, booked at the returns bench.
 * Two steps. Recording it (tracking number + product scan) issues the RET-…
 * number and charges the client's ITEM_RETURN rate. Then someone decides what
 * happens to the goods: disposed of, which costs nothing further, or inspected
 * and put back on a shelf, which is a RETURN stock movement and a second charge
 * at the client's RETURN_RESTOCK rate.
 * When the tracking number matches a dispatched shipment carrying this product,
 * the return is linked to that line and moves its returnedQuantity at the moment
 * it is recorded — the goods have come back whatever is decided for them. That
 * keeps one count shared with the per-line return on the Shipments screen, and
 * stops a later shipment delete putting these units back on the shelf a second
 * time (it restores only what is still out).
 */
// Billable services attached to a bulk shipment when it is created (labelling,
// palletising...). Charged automatically on dispatch, beside the per-unit Bulk
// Shipment rate, at the client's rate on the day it is dispatched.
model FbaShipmentService {
  id               String   @id @default(uuid()) @db.Uuid
  fbaShipmentId    String   @map("fba_shipment_id") @db.Uuid
  serviceId        String   @map("service_id") @db.Uuid
  // The rate it was checked against when attached, then the one it was charged
  // at. Nullable so the row survives the rate being removed.
  clientServiceId  String?  @map("client_service_id") @db.Uuid
  quantity         Decimal  @db.Decimal(10, 2)
  // What it was charged at, written on dispatch. Null until then: the price is
  // whatever the client's rate is when the charge is actually raised.
  appliedUnitPrice Decimal? @map("applied_unit_price") @db.Decimal(14, 2)

  fbaShipment   FbaShipment    @relation(fields: [fbaShipmentId], references: [id], onDelete: Cascade)
  service       Service        @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  clientService ClientService? @relation(fields: [clientServiceId], references: [id], onDelete: SetNull)

  // Once per shipment; quantity carries the repetition.
  @@unique([fbaShipmentId, serviceId], map: "uq_fba_shipment_service_pair")
  @@index([fbaShipmentId], map: "idx_fba_shipment_services_shipment_id")
  @@map("fba_shipment_services")
}

enum ReturnStatus {
  RECORDED
  DISPOSED
  RESTOCKED
}

model ProductReturn {
  id                String       @id @default(uuid()) @db.Uuid
  // RET-<year>-<sequence>, issued the same way as Shipment.reference.
  reference         String       @unique(map: "uq_product_returns_reference") @db.VarChar(64)
  // The courier number on the parcel that came back, as scanned. Null when
  // booked from a shipment line (the line is the link) and the shipment had none.
  trackingNumber    String?      @map("tracking_number") @db.VarChar(64)
  // Whose goods these are. Taken from the product, never from the request.
  clientId          String       @map("client_id") @db.Uuid
  productId         String       @map("product_id") @db.Uuid
  quantity          Int
  status            ReturnStatus @default(RECORDED)
  // The dispatched shipment the tracking number matched, and the line on it
  // carrying this product. Both optional: plenty of returns arrive under a
  // label this system never issued.
  shipmentId        String?      @map("shipment_id") @db.Uuid
  shipmentItemId    String?      @map("shipment_item_id") @db.Uuid
  // The same for a bulk shipment, when booked from its line's Return button.
  // A return names one or the other, never both.
  fbaShipmentId     String?      @map("fba_shipment_id") @db.Uuid
  fbaShipmentItemId String?      @map("fba_shipment_item_id") @db.Uuid
  // Where it went back on the shelf. Set only when RESTOCKED.
  restockLocationId String?      @map("restock_location_id") @db.Uuid
  notes             String?      @db.Text
  dispositionNotes  String?      @map("disposition_notes") @db.Text
  // Plain ids, as on FbaShipment: an audit breadcrumb, not a relation to walk.
  recordedByUserId  String?      @map("recorded_by_user_id") @db.Uuid
  resolvedByUserId  String?      @map("resolved_by_user_id") @db.Uuid
  recordedAt        DateTime     @default(now()) @map("recorded_at") @db.Timestamptz(6)
  resolvedAt        DateTime?    @map("resolved_at") @db.Timestamptz(6)

  client          Client             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  product         Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  shipment        Shipment?          @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  shipmentItem    ShipmentItem?      @relation(fields: [shipmentItemId], references: [id], onDelete: SetNull)
  fbaShipment     FbaShipment?       @relation(fields: [fbaShipmentId], references: [id], onDelete: SetNull)
  fbaShipmentItem FbaShipmentItem?   @relation(fields: [fbaShipmentItemId], references: [id], onDelete: SetNull)
  restockLocation WarehouseLocation? @relation(fields: [restockLocationId], references: [id], onDelete: Restrict)
  invoiceLines    InvoiceLineItem[]

  @@index([recordedAt(sort: Desc), id], map: "idx_product_returns_recorded_at")
  @@index([status, recordedAt(sort: Desc)], map: "idx_product_returns_status_recorded_at")
  @@index([clientId, recordedAt(sort: Desc)], map: "idx_product_returns_client_recorded_at")
  @@index([trackingNumber], map: "idx_product_returns_tracking_number")
  @@index([productId], map: "idx_product_returns_product_id")
  @@index([shipmentItemId], map: "idx_product_returns_shipment_item_id")
  @@index([fbaShipmentId], map: "idx_product_returns_fba_shipment_id")
  @@index([fbaShipmentItemId], map: "idx_product_returns_fba_shipment_item_id")
  @@map("product_returns")
}

