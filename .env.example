PORT=8000
NODE_ENV=development

# --- Database ---
# Prefer PgBouncer in production. Size connection_limit against Postgres max_connections / replica count.
# Example direct:  postgres://user:password@localhost:5432/ProPackers?connection_limit=10&pool_timeout=20
# Example via PgBouncer: postgres://user:password@localhost:6432/ProPackers?pgbouncer=true&connection_limit=10&pool_timeout=20
DATABASE_URL="postgres://user:password@localhost:5432/ProPackers?connection_limit=10&pool_timeout=20"

# --- Auth / JWT ---
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-generate-a-64-byte-hex-secret
JWT_EXPIRES_IN=12h
AUTH_USER_CACHE_TTL_MS=45000

# Pepper mixed into OTP hashing (HMAC). Generate a fresh random value per environment.
OTP_PEPPER=change-me-generate-a-random-secret

# --- CORS ---
CORS_ORIGINS=http://localhost:5173

# --- Redis (optional — enables shared rate limits / caching across replicas) ---
REDIS_URL=

# --- Object storage (optional — S3-compatible; falls back to local ./uploads) ---
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Mail ---
MAIL_TRANSPORT=
MAIL_DEBUG=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@example.com
MAIL_QUEUE_MAX_ATTEMPTS=3
MAIL_QUEUE_BASE_DELAY_MS=1000

APP_BASE_URL=http://localhost:5173
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
INVITE_EXPIRY_HOURS=24

JSON_BODY_LIMIT=1mb
SHUTDOWN_TIMEOUT_MS=15000
LOG_LEVEL=info
WEB_CONCURRENCY=max
