PORT=8000
NODE_ENV=development

# --- Database ---
# Prefer PgBouncer in production. Size connection_limit against Postgres max_connections / replica count.
# Example direct:  postgres://user:password@localhost:5432/ProPackers?connection_limit=10&pool_timeout=20
# Example via PgBouncer: postgres://user:password@localhost:6432/ProPackers?pgbouncer=true&connection_limit=10&pool_timeout=20
DATABASE_URL="postgres://user:password@localhost:5432/ProPackers?connection_limit=10&pool_timeout=20"

# Direct database connection, used only by `prisma migrate`.
# Migrations cannot run through a transaction-mode pooler (Supabase port
# 6543): pgbouncer does not support the advisory locks Prisma takes. Point
# DATABASE_URL at the pooler and this at the direct connection (port 5432).
# Where there is no pooler, set both to the same value.
DIRECT_URL=postgresql://user:password@localhost:5432/propackers

# --- Auth / JWT ---
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-generate-a-64-byte-hex-secret
JWT_EXPIRES_IN=12h
AUTH_USER_CACHE_TTL_MS=45000

# Pepper mixed into OTP hashing (HMAC). Generate a fresh random value per environment.
OTP_PEPPER=change-me-generate-a-random-secret

# --- CORS ---
CORS_ORIGINS=http://localhost:5173

# --- Session cookie ---
# Set to "true" only when the app and the API are on DIFFERENT sites — Vercel
# plus Render, say, where .vercel.app and .onrender.com are separate registrable
# domains. It switches the refresh cookie from SameSite=Lax to SameSite=None,
# because a Lax cookie is never sent cross-site at all and the session then dies
# on every reload.
#
# It is NOT a complete answer to a split deployment: a SameSite=None cookie is
# still a third-party cookie, and iOS Safari, Firefox, Brave and any private
# window block those outright — those users get signed out however this is set.
# The fix that reaches them is putting both hosts under one domain
# (app.example.com + api.example.com), which makes them same-site; then leave
# this false and keep the CSRF protection Lax gives for free.
#
# Only the literal "true" enables it.
CROSS_SITE_COOKIES=false

# --- Serving the front end from this service ---
# Where the built front end lives. Present and this service serves the app as
# well as the API, which is the arrangement that makes the session cookie
# first-party and CROSS_SITE_COOKIES unnecessary. Absent and this stays a pure
# API, which is what an API-only deployment and the test suite want.
#
# Build it in the front-end repo with VITE_BASE_API_URL unset, so the bundle
# calls /api on whatever origin served it, then copy dist/ here.
FRONTEND_DIST=./client

# --- Redis (optional â€” enables shared rate limits / caching across replicas) ---
REDIS_URL=

# --- Object storage (optional â€” S3-compatible; falls back to local ./uploads) ---
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Mail ---
MAIL_TRANSPORT=
MAIL_DEBUG=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@example.com
MAIL_QUEUE_MAX_ATTEMPTS=3
MAIL_QUEUE_BASE_DELAY_MS=1000

APP_BASE_URL=http://localhost:5173
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
INVITE_EXPIRY_HOURS=24

JSON_BODY_LIMIT=1mb
SHUTDOWN_TIMEOUT_MS=15000
LOG_LEVEL=info
WEB_CONCURRENCY=max

# â”€â”€â”€ Email â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# brevo -> HTTPS API   smtp -> direct SMTP   anything else -> mock, sends nothing
#
# Render's free tier blocks outbound SMTP (ports 25, 465, 587) entirely, so a
# direct connection cannot work there however correct the credentials are. The
# HTTP API is an ordinary HTTPS request and is unaffected.
MAIL_TRANSPORT=brevo
BREVO_API_KEY=xkeysib-...
# Must be a sender verified in Brevo, or every message is refused.
MAIL_FROM=noreply@yourdomain.com
MAIL_FROM_NAME=Pro Packers UK

# Only for MAIL_TRANSPORT=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_IP_FAMILY=4
