{
  "name": "propackers-uk-backend",
  "version": "1.0.0",
  "description": "Backend API for ProPackers UK",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:cluster": "pm2-runtime ecosystem.config.cjs",
    "dev": "nodemon server.js",
    "prisma:format": "prisma format",
    "prisma:generate": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f docker-compose.test.yml down -v"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.787.0",
    "@prisma/client": "^6.19.0",
    "axios": "^1.15.2",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.5.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "nodemailer": "^9.0.5",
    "pino-http": "^10.4.0",
    "pm2": "^6.0.5",
    "rate-limit-redis": "^4.2.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prisma": "^6.19.0",
    "supertest": "^7.2.2",
    "vitest": "^4.1.11"
  }
}
